Build1=Default,b4a.example
File1=Layout.bal
FileGroup1=Default Group
Group=Default Group
Library1=core
Library2=xui
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
Module1=Starter
NumberOfFiles=1
NumberOfLibraries=2
NumberOfModules=1
Version=13.5
@EndOfDesignText@
'Activity module
Sub Process_Globals
	'These global variables will be declared once when the application starts.
	Private xui As XUI
End Sub

Sub Globals
	'These global variables will be redeclared each time the activity is created.
	Dim pnlTable As Panel
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Activity.LoadLayout("main")
    
	Dim NumCols As Int = 4
	Dim NumRows As Int = 3
	Dim CellWidth As Int = Activity.Width / NumCols
	Dim CellHeight As Int = 80dip
	Dim BorderSize As Int = 1dip
    
	' Table data: Row x Column
	Dim TableData(NumRows, NumCols) As String
	TableData(0, 0) = "Column 1"  : TableData(0, 1) = "Column 2"  : TableData(0, 2) = "Column 3"  : TableData(0, 3) = "Column 4"
	TableData(1, 0) = "Row 1 C1"  : TableData(1, 1) = "Row 1 C2"  : TableData(1, 2) = "Row 1 C3"  : TableData(1, 3) = "Row 1 C4"
	TableData(2, 0) = "Row 2 C1"  : TableData(2, 1) = "Row 2 C2"  : TableData(2, 2) = "Row 2 C3"  : TableData(2, 3) = "Row 2 C4"
	
	' Create table panel container
	pnlTable.Initialize("pnlTable")
	pnlTable.Color = Colors.Black ' border color
	Activity.AddView(pnlTable, 0, 50dip, Activity.Width, NumRows * CellHeight + BorderSize)
	
	Dim r As Int
	Dim c As Int
	
	For r = 0 To NumRows - 1
		For c = 0 To NumCols - 1
			
			' Cell background panel (for border effect)
			Dim pnlCell As Panel
			pnlCell.Initialize("pnlCell")
			pnlCell.Color = Colors.Black
			pnlTable.AddView(pnlCell, c * CellWidth, r * CellHeight, CellWidth, CellHeight)
			
			' Inner label with padding (simulates border)
			Dim lblCell As Label
			lblCell.Initialize("lblCell")
			lblCell.Text = TableData(r, c)
			lblCell.Gravity = Gravity.CENTER
			lblCell.TextSize = 14
			
			' Header row gets different background
			If r = 0 Then
				lblCell.Color = Colors.RGB(63, 81, 181)  ' Blue header
				lblCell.TextColor = Colors.White
			Else
				If r Mod 2 = 0 Then
					lblCell.Color = Colors.RGB(232, 234, 246)  ' Light stripe
				Else
					lblCell.Color = Colors.White
				End If
				lblCell.TextColor = Colors.Black
			End If
            
			pnlCell.AddView(lblCell, BorderSize, BorderSize, CellWidth - BorderSize * 2, CellHeight - BorderSize * 2)
            
		Next
	Next
    
End Sub

Sub Activity_Resume

End Sub

Sub Activity_Pause(UserClosed As Boolean)

End Sub
