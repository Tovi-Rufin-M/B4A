#Region Project Attributes 
	#ApplicationLabel: B4A Example
	#VersionCode: 1
	#VersionName: 
	'SupportedOrientations possible values: unspecified, landscape or portrait.
	#SupportedOrientations: portrait
	#CanInstallToExternalStorage: False
#End Region

#Region Activity Attributes 
	#FullScreen: False
	#IncludeTitle: False
#End Region

Sub Process_Globals
	'These global variables will be declared once when the application starts.
	'These variables can be accessed from all modules.
	Private xui As XUI
	Dim StringUtils1 As StringUtils
End Sub

Sub Globals
	'These global variables will be redeclared each time the activity is created.
	Private SV As ScrollView
	Type RowCol (Row As Int, Col As Int)
	Private Table As Panel
	
	Dim List1 As List
	
	Dim NumberOfColumns, RowHeight, ColumnWidth, Alignment As Int
	Dim HeaderColor, FontColor, HeaderFontColor As Int
	Dim FontSize As Float
	
	Private Drawer As B4XDrawer
	Private pnlmain As Panel
	Private pnlmenu As Panel
	Private Panel36 As Panel
End Sub

Sub Activity_Resume

End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

Sub Activity_Create(FirstTime As Boolean)
	' Load your layout (Make sure your ScrollView 'SV' is in this layout)
	Activity.LoadLayout("main")
	
	initdrawer
	'Table settings (initialize before any table operations)
	HeaderColor = Colors.Transparent
	NumberOfColumns = 4 'will be overwritten when loading from CSV file.
	RowHeight = 30dip
	'TableColor = Colors.Red
	FontColor = Colors.Black
	HeaderFontColor = Colors.Black
	FontSize = 14
	Alignment = Gravity.LEFT 'change to Gravity.LEFT or Gravity.RIGHT for other alignments.
End Sub

Sub btnMenu_Click
	Drawer.LeftOpen = Not(Drawer.LeftOpen)
End Sub

Sub initdrawer
	Drawer.Initialize(Me, "Drawer", Activity, 260dip)
	Drawer.CenterPanel.BringToFront
	Drawer.LeftPanel.BringToFront
	
	pnlmain = Drawer.CenterPanel
	pnlmenu = Drawer.LeftPanel
	
	SetGradient(pnlmenu, Colors.rgb(175, 71, 210), Colors.RGB(38, 53, 93))
	CreateMenu
End Sub

Sub CreateMenu
	Dim btnDashBoard, btnGrades, btnSubjects, btnProfile As Button
	btnDashBoard.Initialize("btnHome")
	btnDashBoard.Text = "DashBoard"
	btnGrades.Initialize("btnGrades")
	btnGrades.Text = "Grades"
	btnSubjects.Initialize("btnSubjects")
	btnSubjects.Text = "Subjects" 'temporary text
	btnProfile.Initialize("btnProfile")
	btnProfile.Text = "Profile" 'temporary text
	
	For Each b As Button In Array(btnDashBoard, btnGrades, btnSubjects, btnProfile)
		b.TextSize = 16
		b.Gravity = Gravity.LEFT + Gravity.CENTER_VERTICAL
		b.Color = Colors.Transparent
		b.TextColor = Colors.White
		pnlmenu.AddView(b, 10dip, 0, 240dip, 50dip)
	Next
	btnDashBoard.Top = 120dip
	btnGrades.Top = 180dip
	btnSubjects.Top = 240dip
	btnProfile.Top = 300dip
End Sub

Sub btnDashBoard_Click
	Drawer.LeftOpen = False
	showdashboard
End Sub

Sub btnGrades_Click
	Drawer.LeftOpen = False
	showgrades
End Sub

Sub btnSubjects_Click
	Drawer.LeftOpen = False
End Sub

Sub btnProfile_Click
	Drawer.LeftOpen = False
	showprofile
End Sub

Sub showdashboard
	pnlmain.RemoveAllViews
	pnlmain.LoadLayout("dashboard")
End Sub

Sub showgrades
	pnlmain.RemoveAllViews
	pnlmain.LoadLayout("dashboard")
End Sub

Sub showprofile
	ShowTable
	Panel36.Color = 0xFF1AEA00
End Sub

Sub ShowTable
	pnlmain.RemoveAllViews
	pnlmain.LoadLayout("profile") 'layout contains the ScrollView SV
	Table = SV.Panel
	ColumnWidth = SV.Width / NumberOfColumns
	loadtable(File.DirAssets, "citylist.csv")
End Sub

Sub loadtable(Dir As String, Filename As String)
	header(Dir, Filename)
	For i = 0 To List1.Size - 1
		Dim row() As String
		row = List1.Get(i)
		AddRow(row)
	Next
End Sub

Sub header(Dir As String, Filename As String)
    Dim headers As List
    headers.Initialize ' FIX 1: Initialize the list before passing it to LoadCSV2
    ' Load the CSV
    List1 = StringUtils1.LoadCSV2(Dir, Filename, ",", headers)
    NumberOfColumns = headers.Size
    ColumnWidth = SV.Width / NumberOfColumns ' update the columns widths
    For i = 0 To NumberOfColumns - 1
        Dim l As Label
        l.Initialize("header")
        l.Text = headers.Get(i) ' Read directly from the headers list
        l.Gravity = Gravity.LEFT
        l.TextSize = FontSize
        l.Color = HeaderColor
        l.TextColor = HeaderFontColor
		l.Padding = Array As Int (10dip, 5dip, 0dip, 5dip)
        l.Tag = i
		Table.AddView(l, ColumnWidth * i, 0, ColumnWidth, RowHeight)
	Next
End Sub
'Adds a row to the table
Sub AddRow(Values() As String)
	If Values.Length <> NumberOfColumns Then
		Log("Wrong number of values.")
		Return
	End If
	Dim lastRow As Int
	lastRow = NumberOfRows
	For i = 0 To NumberOfColumns - 1
		Dim l As Label
		l.Initialize("cell")
		l.Text = Values(i)
		l.Gravity = Alignment
		l.TextSize = FontSize
		l.TextColor = FontColor
		l.Padding = Array As Int (10dip, 0, 0, 0)
		Dim rc As RowCol
		rc.Initialize
		rc.Col = i
		rc.Row = lastRow
		l.Tag = rc
		Table.AddView(l, ColumnWidth * i, RowHeight * lastRow, ColumnWidth, RowHeight)
	Next
	Table.Height = NumberOfRows * RowHeight
End Sub

Sub NumberOfRows As Int
	Return Table.NumberOfViews / NumberOfColumns
End Sub

' Add this Sub to your code
Sub SetGradient(Panel As Panel, Color1 As Int, Color2 As Int)
	Dim gd As GradientDrawable
	gd.Initialize("BR_TL", Array As Int(Color1, Color2))
	Panel.Background = gd
End Sub

