		CheckBox2.Checked = False
	End If
End Sub

Private Sub Panel2_Click
	updatedata
End Sub

Private Sub updatedata_Click
	updatedata
End Sub

Sub updatedata
	' Validate name and ID
	If STUDENT_NAME.Text.Trim = "" Or STUDENT_ID.Text.Trim = "" Then
		xui.MsgboxAsync("Please enter Student Name and Student ID.", "Validation Error")
		Return
	End If
	
	' Validate scores
	If EditText1.Text.Trim = "" Or EditText2.Text.Trim = "" Then
		xui.MsgboxAsync("Please enter the complete score/rate (e.g. 15/20).", "Validation Error")
		Return
	End If
	
	' Determine attendance selection
	Dim attendance As String = "present"
	If CheckBox2.Checked Then
		attendance = "late"
	Else If CheckBox3.Checked Then
		attendance = "absent"
	End If
	
	' Construct rate string
	Dim rate As String = EditText1.Text.Trim & "/" & EditText2.Text.Trim
	
	Dim msg As String
	If editRowIndex > -1 Then
		' Update existing record
		Dim row() As String = StudentList.Get(editRowIndex)
		row(0) = STUDENT_NAME.Text.Trim
		row(1) = STUDENT_ID.Text.Trim
		row(2) = SELECTSUBJECTS.SelectedItem
		row(3) = STUDENT_ACTIVITY.SelectedItem
		row(4) = attendance
		row(5) = rate
		StudentList.Set(editRowIndex, row)
		msg = "Student record updated successfully!"
	Else
		' Create new student row array
		Dim newRow(6) As String
		newRow(0) = STUDENT_NAME.Text.Trim
		newRow(1) = STUDENT_ID.Text.Trim
		newRow(2) = SELECTSUBJECTS.SelectedItem
		newRow(3) = STUDENT_ACTIVITY.SelectedItem
		newRow(4) = attendance
		newRow(5) = rate
		StudentList.Add(newRow)
		msg = "Student record added successfully!"
	End If
	
	' Save the list back to CSV file
	StringUtils1.SaveCSV2(File.DirInternal, "student.csv", ",", StudentList, CSVHeaders)
	
	' Reload data to refresh all lists in memory
	LoadStudentData
	
	' Show success message and navigate back to edit screen
	xui.MsgboxAsync(msg, "Success")
	showedit
End Sub