'=============================================================================
' SECTION 10: PROFILE SCREEN (Table View)
'=============================================================================

Sub showprofile
	HighlightTab(profilebtn)
	ShowTable
End Sub

Sub ShowTable
	pnlmain.RemoveAllViews
	pnlmain.LoadLayout("profile")
	Table = SV.Panel
	NumberOfColumns = 6
	ColumnWidth = SV.Width / NumberOfColumns
	loadtable
	
	' Display the currently selected student profile (fallback to first student if none selected)
	If selectedStudent <> "" Then
		DisplayStudentProfile(selectedStudent)
	Else If StudentList.Size > 0 Then
		Dim row() As String = StudentList.Get(0)
		selectedStudent = row(COL_NAME)
		DisplayStudentProfile(selectedStudent)
	End If
End Sub

' Populates all labels on the profile layout for a given student
Sub DisplayStudentProfile(studentName As String)
	If studentName = "" Then Return
	
	' Retrieve student details
	Dim id As String = GetStudentID(studentName)
	Dim grade As String = GetStudentGrade(studentName)
	
	' Display Basic Details
	studid.Text = id
	studname.Text = studentName

	' Display GPA and Attendance Status
	gpaslt.Text = GetGPADisplayText(studentName)
	anttslt.Text = GetAverageAttendanceScoredisplay(studentName)
	hstslt.Text = grade

	' Reset Top 3 Subject labels first
	Top1sub.Text = "-"
	Top1grd.Text = "-"
	Top2sub.Text = "-"
	Top2grd.Text = "-"
	Top3sub.Text = "-"
	Top3grd.Text = "-"

	' Fetch and display top subjects
	Dim topList As List = GetTop3Subjects(studentName)
	
	If topList.Size > 0 Then
		Dim entry() As Object = topList.Get(0)
		Dim subject As String = entry(0)
		Dim avgScore As Double = entry(1)
		Top1sub.Text = subject
		Top1grd.Text = PercentageToGrade(avgScore) & " (" & NumberFormat2(avgScore, 1, 0, 1, False) & "%)"
	End If
	
	If topList.Size > 1 Then
		Dim entry() As Object = topList.Get(1)
		Dim subject As String = entry(0)
		Dim avgScore As Double = entry(1)
		Top2sub.Text = subject
		Top2grd.Text = PercentageToGrade(avgScore) & " (" & NumberFormat2(avgScore, 1, 0, 1, False) & "%)"
	End If
	
	If topList.Size > 2 Then
		Dim entry() As Object = topList.Get(2)
		Dim subject As String = entry(0)
		Dim avgScore As Double = entry(1)
		Top3sub.Text = subject
		Top3grd.Text = PercentageToGrade(avgScore) & " (" & NumberFormat2(avgScore, 1, 0, 1, False) & "%)"
	End If
End Sub

Sub loadtable
	' Use already loaded CSV headers and list from single source of truth
	NumberOfColumns = CSVHeaders.Size
	ColumnWidth = SV.Width / NumberOfColumns
	
	' Render Header Row
	For i = 0 To NumberOfColumns - 1
		Dim l As Label
		l.Initialize("header")
		l.Text = CSVHeaders.Get(i)
		l.Gravity = Gravity.LEFT
		l.TextSize = FontSize - 4
		l.Color = HeaderColor
		l.TextColor = HeaderFontColor
		l.Padding = Array As Int(10dip, 5dip, 0dip, 5dip)
		l.Tag = i
		Table.AddView(l, ColumnWidth * i, 0, ColumnWidth, RowHeight)
	Next
	
	' Render Data Rows
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		AddTableRow(row, i + 1)  ' +1 to skip header row height
	Next
	
	Table.Height = (StudentList.Size + 1) * RowHeight
End Sub

Sub AddTableRow(Values() As String, rowIndex As Int)
	If Values.Length <> NumberOfColumns Then
		Log("Wrong number of values.")
		Return
	End If
	For i = 0 To NumberOfColumns - 1
		Dim l As Label
		l.Initialize("cell")
		l.Text = Values(i)
		l.Gravity = Alignment
		l.TextSize = FontSize
		l.TextColor = FontColor
		l.Padding = Array As Int(10dip, 0, 0, 0)
		Dim rc As RowCol
		rc.Initialize
		rc.Col = i
		rc.Row = rowIndex
		l.Tag = rc
		Table.AddView(l, ColumnWidth * i, RowHeight * rowIndex, ColumnWidth, RowHeight)
	Next
End Sub

Sub GetUnique(source As List) As List
	Dim seen As Map
	seen.Initialize
	Dim unique As List
	unique.Initialize
	Dim item As String        ' ✅ Declared outside the loop
	For i = 0 To source.Size - 1
		item = source.Get(i)  ' ✅ Only assignment inside
		If seen.ContainsKey(item) = False Then
			seen.Put(item, True)
			unique.Add(item)
		End If
	Next
	Return unique
End Sub

Sub loadspinner
	If student_subjects.IsInitialized = False Then Return
	SELECTSUBJECTS.Clear
	Dim unique_subjects As List = GetUnique(student_subjects)
	For i = 0 To unique_subjects.Size - 1
		SELECTSUBJECTS.Add(unique_subjects.Get(i))
	Next
	If student_activitys.IsInitialized = False Then Return
	STUDENT_ACTIVITY.Clear
	Dim unique_activities As List = GetUnique(student_activitys)
	For i = 0 To unique_activities.Size - 1
		STUDENT_ACTIVITY.Add(unique_activities.Get(i))
	Next
End Sub

Sub showselectids
	If showselectid Then
		isselectingid = True
		If update.IsInitialized Then update.Enabled = False
		
		' 1. Safely remove the overlay if it was already initialized
		If bak.IsInitialized Then
			bak.RemoveView
		End If
		
		' 2. Initialize background overlay
		bak.Initialize("bak")
		bak.Color = 0x68000000
		
		Dim pnlCard As Panel
		pnlCard.Initialize("pnlCard")

		' 3. Create a unique drawable for the Card Panel
		Dim cdCard As ColorDrawable
		cdCard.Initialize2(0xFF2C2C2C, 40dip, 0dip, 0xFF000000)
		pnlCard.Background = cdCard
		pnlCard.Elevation = 4dip

		' Define card dimensions and positioning
		Dim pnlLeft As Int = 30dip
		Dim pnlTop As Int = 220dip
		Dim pnlWidth As Int = 300dip
		Dim pnlHeight As Int = 280dip
	
		' Title Label (Padding removed as it is not a default B4A property)
		Dim lbl As Label
		lbl.Initialize("lbl")
		lbl.Text = "SELECT ID"
		lbl.Gravity = Bit.Or(Gravity.CENTER_HORIZONTAL, Gravity.CENTER_VERTICAL)
		lbl.Typeface = Typeface.CreateNew(Typeface.SERIF, Typeface.STYLE_BOLD_ITALIC)
		lbl.TextSize = 20
		lbl.TextColor = Colors.White
		pnlCard.AddView(lbl, 35dip, 30dip, 230dip, 40dip)

		' Spinner
		spinner.Initialize("spinner")
		spinner.TextColor = Colors.Black
		spinner.AddAll(GetUnique(student_ids))
		spinner.Color = Colors.White
		pnlCard.AddView(spinner, 75dip, 115dip, 150dip, 50dip)

		' Action Button
		Dim btn As Button
		btn.Initialize("btn")
		btn.Text = "SELECT"
		btn.Gravity = Bit.Or(Gravity.CENTER_HORIZONTAL, Gravity.CENTER_VERTICAL)
		btn.Typeface = Typeface.DEFAULT_BOLD
		btn.TextColor = Colors.Black
		btn.Color = Colors.White
		pnlCard.AddView(btn, 50dip, 210dip, 200dip, 43dip)
		
		' Add the card to the background overlay
		bak.AddView(pnlCard, pnlLeft, pnlTop, pnlWidth, pnlHeight)
		
		' 4. Add the overlay to the center of the Activity screen
		Activity.AddView(bak, 0, 0, Activity.Width, Activity.Height)
		
	Else
		' 5. Clean up the panel from the screen when closing
		If bak.IsInitialized Then
			bak.RemoveView
		End If
		If update.IsInitialized Then update.Enabled = True
	End If
End Sub

Private Sub btn_Click
	' 1. Select the spinner item
	Dim serch_id As String = spinner.SelectedItem
	
	' 2. Hide/remove the overlay panel
	showselectid = False
	isselectingid = False
	If update.IsInitialized Then update.Enabled = True
	showselectids
	
	' 3. Find student index
	editRowIndex = -1
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		If row(1) = serch_id Then
			editRowIndex = i
			Exit
		End If
	Next
	
	' 4. Handle deletion if todelete flag is True
	If editRowIndex > -1 Then
		If todelete Then
			Dim row() As String = StudentList.Get(editRowIndex)
			Dim studentName As String = row(0)
			
			' Remove from list
			StudentList.RemoveAt(editRowIndex)
			
			' Save the updated list back to CSV file
			StringUtils1.SaveCSV2(File.DirInternal, "student.csv", ",", StudentList, CSVHeaders)
			
			' Reload data to refresh all lists in memory
			LoadStudentData
			
			xui.MsgboxAsync("Deleted record for " & studentName & " successfully.", "Success")
			
			editRowIndex = -1
			todelete = False
			Return
		End If
	End If
	
	' 5. Load the layout into pnlmain for editing (if not deleting)
	pnlmain.RemoveAllViews
	pnlmain.LoadLayout("CREAT")
	
	If editRowIndex > -1 Then
		Dim row() As String = StudentList.Get(editRowIndex)
		STUDENT_NAME.Text = row(0)
		STUDENT_ID.Text = row(1)
		
		' Fill the spinner selections
		loadspinner
		
		' Set selected subject in SELECTSUBJECTS spinner
		Dim subject As String = row(2)
		For i = 0 To SELECTSUBJECTS.Size - 1
			If SELECTSUBJECTS.GetItem(i) = subject Then
				SELECTSUBJECTS.SelectedIndex = i
				Exit
			End If
		Next
		
		' Set selected activity in STUDENT_ACTIVITY spinner
		Dim activity11 As String = row(3)
		For i = 0 To STUDENT_ACTIVITY.Size - 1
			If STUDENT_ACTIVITY.GetItem(i) = activity11 Then
				STUDENT_ACTIVITY.SelectedIndex = i
				Exit
			End If
		Next
		
		' Set attendance check boxes
		Dim attendance As String = row(4)
		CheckBox1.Checked = (attendance = "present")
		CheckBox2.Checked = (attendance = "late")
		CheckBox3.Checked = (attendance = "absent")
		
		' Set rate
		Dim rate As String = row(5)
		If rate.Contains("/") Then
			Dim parts() As String = Regex.Split("/", rate)
			If parts.Length = 2 Then
				EditText1.Text = parts(0)
				EditText2.Text = parts(1)
			Else
				EditText1.Text = rate
				EditText2.Text = ""
			End If
		Else
			EditText1.Text = rate
			EditText2.Text = ""
		End If
	End If
End Sub

Private Sub bak_Click
	If isselectingid Then
		showselectid = False
		isselectingid = False
		If update.IsInitialized Then update.Enabled = True
		showselectids
	Else
		showselectids
		MsgboxAsync("run", "works") ' Fixed warning #34 by using Async method
		Return
	End If
End Sub

