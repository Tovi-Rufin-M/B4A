End Sub

Sub HighlightTab(activeBtn As Panel)
	dashbtn.Color = Colors.White
	grdbtn.Color = Colors.White
	editbtn.Color = Colors.White
	profilebtn.Color = Colors.White
	activeBtn.Color = 0xFF1AEA00
End Sub

'=============================================================================
' SECTION 4: DATA LAYER (Load, Save, Grade Computation)
'=============================================================================

Sub LoadStudentData
	' Copy student.csv from Assets to Internal storage if it doesn't exist yet
	If File.Exists(File.DirInternal, "student.csv") = False Then
		If File.Exists(File.DirAssets, "student.csv") Then
			File.Copy(File.DirAssets, "student.csv", File.DirInternal, "student.csv")
		Else
			' Create a default empty CSV file if it doesn't exist in assets
			Dim headers As List
			headers.Initialize2(Array As String("Name", "ID", "Subject", "Activity", "Attendance", "Rate"))
			Dim emptyList As List
			emptyList.Initialize
			StringUtils1.SaveCSV2(File.DirInternal, "student.csv", ",", emptyList, headers)
		End If
	End If

	CSVHeaders.Initialize
	Dim rawList As List = StringUtils1.LoadCSV2(File.DirInternal, "student.csv", ",", CSVHeaders)
	
	' Only add valid rows (filtering out blank lines at the end of CSV)
	StudentList.Initialize
	For i = 0 To rawList.Size - 1
		Dim row() As String = rawList.Get(i)
		If row.Length >= 6 Then
			StudentList.Add(row)
		End If
	Next
	
	' Initialize global lists for student properties
	student_names.Initialize
	student_ids.Initialize
	student_subjects.Initialize
	student_activitys.Initialize
	student_attendance.Initialize
	student_rate.Initialize
	
	' Populate global lists from the single source of truth (StudentList)
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		student_names.Add(row(0))
		student_ids.Add(row(1))
		student_subjects.Add(row(2))
		student_activitys.Add(row(3))
		student_attendance.Add(row(4))
		student_rate.Add(row(5))
	Next
End Sub


' Parses a rate string like "11/20" and returns a percentage (0-100)
Sub ComputePercentage(rate As String) As Double
	If rate.Contains("/") = False Then Return 0
	Dim parts() As String = Regex.Split("/", rate)
	If parts.Length <> 2 Then Return 0
	Dim numerator As Double = parts(0)
	Dim denominator As Double = parts(1)
	If denominator = 0 Then Return 0
	Return (numerator / denominator) * 100
End Sub

' Returns a letter grade from a percentage
Sub PercentageToGrade(pct As Double) As String
	If pct >= 90 Then Return "A"
	If pct >= 80 Then Return "B"
	If pct >= 70 Then Return "C"
	If pct >= 60 Then Return "D"
	Return "F"
End Sub

' Converts percentage to 4.0 GPA scale points (Double)
Sub PercentageToGPAPoints(pct As Double) As Double
	If pct >= 90 Then Return 4.0
	If pct >= 80 Then Return 3.0
	If pct >= 70 Then Return 2.0
	If pct >= 60 Then Return 1.0
	Return 0.0
End Sub

' Calculates the GPA for a student. Returns -1.0 if they have fewer than 3 activities.
Sub CalculateStudentGPA(studentName As String) As Double
	Dim totalPoints As Double = 0
	Dim activityCount As Int = 0
	
	' Loop through all student records
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		Dim currentName As String = row(COL_NAME)
		
		' Check if the record belongs to the target student
		If currentName = studentName Then
			Dim rateString As String = row(COL_RATE)
			
			' Compute percentage for this activity
			Dim pct As Double = ComputePercentage(rateString)
			
			' Convert percentage to 4.0 scale points and add to sum
			totalPoints = totalPoints + PercentageToGPAPoints(pct)
			activityCount = activityCount + 1
		End If
	Next
	
	' ENFORCE MINIMUM 3 ACTIVITIES CONSTRAINT:
	If activityCount < 3 Then
		Return -1.0 ' Return -1.0 as a flag meaning "Not enough activities to calculate GPA"
	End If
	
	' Return GPA averaged out
	Return totalPoints / activityCount
End Sub

Sub GetGPADisplayText(studentName As String) As String
	Dim gpa As Double = CalculateStudentGPA(studentName)
	
	If gpa = -1.0 Then
		Return "N/A (Min 3 activities required)"
	Else
		' Format to 2 decimal places (e.g., "3.67")
		Return NumberFormat2(gpa, 1, 2, 2, False)
	End If
End Sub

' Calculates the average attendance points (out of 10) for a student
Sub GetAverageAttendanceScore(studentName As String) As Double
	Dim totalPoints As Int = 0
	Dim count As Int = 0
	
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		Dim name As String = row(COL_NAME)
		
		If name = studentName Then
			Dim status As String = row(4).Trim.ToLowerCase
			
			' Map each status to points
			Select Case status
				Case "present"
					totalPoints = totalPoints + 10
				Case "late"
					totalPoints = totalPoints + 5
				Case "absent"
					totalPoints = totalPoints + 0
			End Select
			count = count + 1
		End If
	Next
	
	' Avoid division by zero if student has no records
	If count = 0 Then Return 0
	
	Return totalPoints / count
End Sub

Sub GetAverageAttendanceScoredisplay(studentName As String) As String
	Dim aas As Double = GetAverageAttendanceScore(studentName)
	Dim disply As String
	
	Select Case True
		Case aas = 10
			disply = "A+"
		Case aas >= 9.0
			disply = "A"
		Case aas >= 8.5
			disply = "A-"
		Case aas >= 8.0
			disply = "B+"
		Case aas >= 7.0
			disply = "B"
		Case aas >= 6.0
			disply = "B-"
		Case aas >= 5.0
			disply = "C+"
		Case aas >= 4.0
			disply = "C"
		Case aas >= 3.5
			disply = "D+"
		Case aas >= 3.0
			disply = "D"
		Case aas >= 1.0
			disply = "E"
		Case Else
			disply = "F"
	End Select
	
	Return disply
End Sub

' Returns a list containing the top 3 subjects with the highest averages for a student.
' Each item in the returned list is a 2-element array: Array As Object(SubjectName As String, AverageScore As Double)
Sub GetTop3Subjects(studentName As String) As List
	Dim subjectSums As Map
	Dim subjectCounts As Map
	subjectSums.Initialize
	subjectCounts.Initialize
	
	' 1. Group and sum percentages by subject for the selected student
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		Dim name As String = row(COL_NAME)
		
		If name = studentName Then
			Dim subject As String = row(2) ' Subject is at index 2
			Dim pct As Double = ComputePercentage(row(5)) ' Rate is at index 5
			
			' Accumulate sum
			Dim currentSum As Double = 0
			If subjectSums.ContainsKey(subject) Then currentSum = subjectSums.Get(subject)
			subjectSums.Put(subject, currentSum + pct)
			
			' Accumulate count
			Dim currentCount As Int = 0
			If subjectCounts.ContainsKey(subject) Then currentCount = subjectCounts.Get(subject)
			subjectCounts.Put(subject, currentCount + 1)
		End If
	Next
	
	' 2. Calculate the average score for each subject
	Dim subjectAvgs As List
	subjectAvgs.Initialize
	For Each subject As String In subjectSums.Keys
		Dim totalScore As Double = subjectSums.Get(subject)
		Dim count As Int = subjectCounts.Get(subject)
		Dim avg As Double = totalScore / count
		subjectAvgs.Add(Array As Object(subject, avg))
	Next
	
	' 3. Extract the top 3 highest averages using a simple selection sort
	Dim top3 As List
	top3.Initialize
	
	For rank = 0 To Min(2, subjectAvgs.Size - 1)
		Dim bestIdx As Int = -1
		Dim bestVal As Double = -1
		
		For j = 0 To subjectAvgs.Size - 1
			Dim entry() As Object = subjectAvgs.Get(j)
			Dim val As Double = entry(1) ' The average percentage
			If val > bestVal Then
				bestVal = val
				bestIdx = j
			End If
		Next
		
		If bestIdx >= 0 Then
			top3.Add(subjectAvgs.Get(bestIdx))
			subjectAvgs.RemoveAt(bestIdx) ' Remove it so the next loop finds the next highest
		End If
	Next
	
	Return top3
End Sub

' Returns a list of unique student names
Sub GetUniqueStudentNames As List
	Dim names As List
	names.Initialize
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		Dim name As String = row(COL_NAME)
		If names.IndexOf(name) = -1 Then
			names.Add(name)
		End If
	Next
	Return names
End Sub

' Computes average percentage across all records for a student
Sub GetStudentAvgPercentage(studentname As String) As Double
	Dim total As Double = 0
	Dim count As Int = 0
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		If row(COL_NAME) = studentname Then
			total = total + ComputePercentage(row(COL_RATE))
			count = count + 1
		End If
	Next
	If count = 0 Then Return 0
	Return total / count
End Sub

' Returns the letter grade for a student's average
Sub GetStudentGrade(studentname As String) As String
	Return PercentageToGrade(GetStudentAvgPercentage(studentname))
End Sub

'=============================================================================
' SECTION 5: UTILITY SUBS
'=============================================================================

Sub SetGradient(pnl As Panel, Color1 As Int, Color2 As Int)
	Dim gd As GradientDrawable
	gd.Initialize("BR_TL", Array As Int(Color1, Color2))
	pnl.Background = gd
End Sub

Sub getActivity(studentName As String) As String
	Dim activities As String = ""
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		Dim name As String = row(COL_NAME) ' compare against student name column
		If name = studentName Then
			Dim Activitys As String = row(COL_ACTIVITY)
			If activities.IndexOf(Activitys) = -1 Then
				activities = Activitys
			End If
		End If
	Next
	Return activities
End Sub

Sub GetStudentID(studentName As String) As String
	For i = 0 To StudentList.Size - 1
		Dim row() As String = StudentList.Get(i)
		If row(COL_NAME) = studentName Then
			Return row(1) ' ID is in column 1
		End If
	Next
	Return ""
End Sub

Sub GetStudentTopActivity(studentName As String) As String
	' Return the activity name with the highest score, or most recent activity
	' Adjust this based on your data structure

	Return getActivity(studentName)
End Sub

'=============================================================================
' SECTION 6: DASHBOARD SCREEN
'=============================================================================

Sub showdashboard
	pnlmain.RemoveAllViews
	pnlmain.LoadLayout("dashboard")
	generategraph
End Sub

Sub generategraph
	Dim names As List = GetUniqueStudentNames
	If names.Size = 0 Then Return
	
	Dim numCols As Int = names.Size
	Dim colWidth As Int = datapnl.Width / numCols
	
	' Bar colors
	Dim barColors() As Int = Array As Int( _
		Colors.RGB(66, 133, 244), _
		Colors.RGB(234, 67, 53), _
		Colors.RGB(251, 188, 4), _
		Colors.RGB(52, 168, 83), _
		Colors.RGB(156, 39, 176))
	
	' Find max for scaling
	Dim maxVal As Double = 0
	For i = 0 To names.Size - 1
		Dim avg As Double = GetStudentAvgPercentage(names.Get(i))
		If avg > maxVal Then maxVal = avg
	Next
	If maxVal = 0 Then maxVal = 100
	
	Dim RowHeight As Int = 40dip
	Dim valueLabelHeight As Int = 30dip
	Dim chartAreaHeight As Int = datapnl.Height - RowHeight - valueLabelHeight
	Dim barPadding As Int = 10dip
	
	For i = 0 To numCols - 1
		Dim studentName As String = names.Get(i)
		Dim avgPct As Double = GetStudentAvgPercentage(studentName)
		
		' --- Bar ---
		Dim barHeight As Int
		If maxVal > 0 Then
			barHeight = (avgPct / maxVal) * chartAreaHeight
		Else
			barHeight = 0
		End If
		
		Dim barTop As Int = datapnl.Height - RowHeight - barHeight
		
		Dim pnlBar As Panel
		pnlBar.Initialize("pnlBar")
		pnlBar.Color = barColors(i Mod barColors.Length)
		pnlBar.Tag = i
		datapnl.AddView(pnlBar, _
			(colWidth * i) + barPadding, _
			barTop, _
			colWidth - (barPadding * 2), _
			barHeight)
		
		' --- Value Label (percentage on top) ---
		Dim lblValue As Label
		lblValue.Initialize("lblValue")
		lblValue.Text = Round2(avgPct, 0) & "%"
		lblValue.Gravity = Gravity.CENTER
		lblValue.TextSize = 12
		lblValue.TextColor = Colors.Black
		datapnl.AddView(lblValue, _
			colWidth * i, _
			barTop - valueLabelHeight, _
			colWidth, _
			valueLabelHeight)
		
		' --- Name Label (at the bottom) ---
		Dim l As Label
		l.Initialize("labels")
		' Show first name only if name is long
		Dim displayName As String = studentName
		If displayName.Length > 8 Then
			Dim nameParts() As String = Regex.Split(" ", displayName)
			displayName = nameParts(0)
		End If
		l.Text = displayName
		l.Gravity = Gravity.CENTER
		l.TextSize = 10
		l.Color = 0x00ffffff
		l.TextColor = Colors.Black
		l.Padding = Array As Int(0dip, 5dip, 0dip, 5dip)
		l.Tag = i
		datapnl.AddView(l, _
			colWidth * i, _
			datapnl.Height - RowHeight, _
			colWidth, _
			RowHeight)
	Next
	' --- Top 3 Students ---
	' Build a list of name-average pairs and sort descending
	Dim studentAvgs As List
	studentAvgs.Initialize
	For i = 0 To names.Size - 1
		Dim avg As Double = GetStudentAvgPercentage(names.Get(i))
		studentAvgs.Add(Array As Object(names.Get(i), avg))
	Next

	' Simple sort: find top 3 by highest average
	Dim topNames(3) As String
	Dim topRates(3) As Double
	Dim topActivities(3) As String

	For rank = 0 To Min(2, studentAvgs.Size - 1)
		Dim bestIdx As Int = -1
		Dim bestVal As Double = -1
		For j = 0 To studentAvgs.Size - 1
			Dim entry() As Object = studentAvgs.Get(j)
			If entry(1) > bestVal Then
				bestVal = entry(1)
				bestIdx = j
			End If
		Next
		If bestIdx >= 0 Then
			Dim bestEntry() As Object = studentAvgs.Get(bestIdx)
			topNames(rank) = bestEntry(0)
			topRates(rank) = bestEntry(1)
			topActivities(rank) = GetStudentTopActivity(bestEntry(0)) ' <-- you need this helper
			studentAvgs.RemoveAt(bestIdx) ' remove so next iteration finds the next best
		End If
	Next

	' Assign to dashboard labels
	If topNames(0) <> "" Then
		NAME1.Text = topNames(0)
		RATE1.Text = Round2(topRates(0), 1) & "%"
		ACTIVITY1.Text = topActivities(0)
	End If
	If topNames(1) <> "" Then
		NAME2.Text = topNames(1)
		RATE2.Text = Round2(topRates(1), 1) & "%"
		ACTIVITY2.Text = topActivities(1)
	End If
	If topNames(2) <> "" Then
		NAME3.Text = topNames(2)
		RATE3.Text = Round2(topRates(2), 1) & "%"
		ACTIVITY3.Text = topActivities(2)
	End If
End Sub

'=============================================================================
' SECTION 7: GRADES SCREEN
'=============================================================================

Sub showgrades
	pnlmain.RemoveAllViews
	pnlmain.LoadLayout("grades")

	' SV1 is now loaded from layout — get its actual width before touching its panel
	Dim names As List = GetUniqueStudentNames
	Dim studentSize As Int = names.Size

	' ✅ Set the inner panel height FIRST, before adding any views
	' This is what makes the ScrollView actually scrollable
	Dim totalHeight As Int = (studentSize * 108dip) + 40dip
	SV1.Panel.Height = totalHeight
	SV1.Panel.Width = SV1.Width

	SV1.Panel.RemoveAllViews

	makeshadow(studentSize, names)
End Sub
Sub makeshadow(numstudent As Int, studentNames As List)
	Dim itemSpacing As Int = 108dip
	Dim startTopMargin As Int = 20dip

	For i = 0 To numstudent - 1
		Dim currentTop As Int = startTopMargin + (i * itemSpacing)
		
		' Shadow panel
		Dim pnlShadow As Panel
		pnlShadow.Initialize("pnlShadow")

		Dim cd As ColorDrawable
		cd.Initialize2(0xFF000000, 4dip, 0dip, 0xFF000000)
		pnlShadow.Background = cd
		pnlShadow.Elevation = 0

		Dim pnlWidth As Int = 330dip
		Dim pnlHeight As Int = 88dip
		
		Dim shadowLeftPos As Int = gradepnl.Width - 13dip - pnlWidth
		Dim shadowTopPos As Int = currentTop + 7dip

		SV1.Panel.AddView(pnlShadow, shadowLeftPos, shadowTopPos, pnlWidth, pnlHeight)
		
		Dim name As String = studentNames.Get(i)
		Dim grade As String = GetStudentGrade(name)
		studentgrade(name, grade, currentTop)
	Next
End Sub

Sub studentgrade(studentName As String, grade As String, currentTop As Int)
	Dim pnlCard As Panel
	' Use a static event name "pnlCard" so one Sub handles all panel clicks
	pnlCard.Initialize("pnlCard")

	' Look up the student's ID
	Dim studentIdVal As String = GetStudentID(studentName)
	' Store all details inside the Tag Map
	Dim details As Map
	details.Initialize
	details.Put("name", studentName)
	details.Put("grade", grade)
	details.Put("id", studentIdVal) ' <--- Put it in the map here
	pnlCard.Tag = details
	Dim cd As ColorDrawable
	cd.Initialize2(0xFFFFD400, 2dip, 2dip, 0xFF000000)
	pnlCard.Background = cd
	pnlCard.Elevation = 0

	Dim pnlWidth As Int = 330dip
	Dim pnlHeight As Int = 88dip
	Dim rightEdgeDistance As Int = 20dip

	Dim leftPos As Int = gradepnl.Width - rightEdgeDistance - pnlWidth
	Dim topPos As Int = currentTop

	' --- Grade Label (left side of the card) ---
	Dim lblGrade As Label
	' Initialize with "" so the label doesn't block clicks from reaching the parent panel
	lblGrade.Initialize("")
	lblGrade.Text = grade
	lblGrade.TextSize = 30
	lblGrade.TextColor = Colors.Black
	lblGrade.Gravity = Bit.Or(Gravity.CENTER_HORIZONTAL, Gravity.CENTER_VERTICAL)
	lblGrade.Typeface = Typeface.CreateNew(Typeface.SERIF, Typeface.STYLE_BOLD_ITALIC)
	lblGrade.SingleLine = False
	lblGrade.Enabled = True
	lblGrade.Visible = True

	Dim gradeRightEdge As Int = 264dip
	Dim gradeWidth As Int = pnlWidth - gradeRightEdge  ' 66dip
	pnlCard.AddView(lblGrade, 0, 0, gradeWidth, pnlHeight)

	' --- Name Label (right side of the card) ---
	Dim lbl As Label
	' Initialize with "" so the label doesn't block clicks from reaching the parent panel
	lbl.Initialize("")
	lbl.Text = studentName
	lbl.Gravity = Gravity.CENTER_VERTICAL
	lbl.Typeface = Typeface.CreateNew(Typeface.SERIF, Typeface.STYLE_BOLD_ITALIC)
	lbl.TextSize = 20
	lbl.TextColor = Colors.Black
	lbl.Padding = Array As Int(10dip, 5dip, 10dip, 5dip)
	pnlCard.AddView(lbl, gradeWidth, 0, pnlWidth - gradeWidth, pnlHeight)
	SV1.Panel.AddView(pnlCard, leftPos, topPos, pnlWidth, pnlHeight)
End Sub

Sub pnlCard_Click
	' Sender refers to the specific Panel that was clicked
	Dim clickedPanel As Panel = Sender
	
	' Retrieve the Map containing student details
	Dim details As Map = clickedPanel.Tag
	Dim studentName As String = details.Get("name")
	
	' 1. Show confirmation dialog (Message, Title, PositiveButton, CancelButton, NegativeButton, Icon, KeepAlive)
	Msgbox2Async("Do you want to view the details for " & studentName & "?", "Confirm Selection", "Yes", "", "No", Null, False)
	
	' 2. Wait for the user to make a choice
	Wait For Msgbox_Result (Result As Int)
	
	' 3. Proceed only if the user pressed "Yes"
	If Result = DialogResponse.POSITIVE Then
		selectedStudent = studentName
		
		' Load the profile screen layout so that the target labels (studid, studname, etc.) are initialized
		pnlmain.RemoveAllViews
		pnlmain.LoadLayout("profile")
		HighlightTab(profilebtn)
		
		' Initialize the profile table
		Table = SV.Panel
		NumberOfColumns = 6
		ColumnWidth = SV.Width / NumberOfColumns
		loadtable
		
		' Display selected student profile
		DisplayStudentProfile(selectedStudent)
	End If
End Sub

